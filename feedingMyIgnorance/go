package main

import "strings"

func StringToArt(input string) string {
	if len(input) == 0 {
		return ""
	}
	for _, r := range input {
		if r < '0' || r > '9' {
			return ""
		}
	}
	m := map[rune][]string{
		'0': {
			" --- ",
			" | | ",
			" | | ",
			" | | ",
			" --- ",
		},
		'2': {
			" --- ",
			"    |",
			" --- ",
			"|    ",
			" --- ",
		},

		'3': {
			" --- ",
			"    |",
			" --- ",
			"    |",
			" --- ",
		},

		'4': {
			"|  | ",
			"|  | ",
			" --- ",
			"    |",
			"    |",
		},

		'5': {
			" --- ",
			"|    ",
			" --- ",
			"    |",
			" --- ",
		},

		'6': {
			" --- ",
			"|    ",
			" --- ",
			"|   |",
			" --- ",
		},

		'7': {
			" --- ",
			"    |",
			"   | ",
			"  |  ",
			" |   ",
		},

		'8': {
			" --- ",
			"|   |",
			" --- ",
			"|   |",
			" --- ",
		},

		'9': {
			" --- ",
			"|   |",
			" --- ",
			"    |",
			" --- ",
		},
	}
	words := strings.Split(input, "\n")
	var output string
	for i := 0; i < 5; i++ {
		for _, r := range words {
			if val, ok := m[r]; ok {
				output += val[i]
			}
		}
	}
	return output
}
